# CellSeer production environment.
# Copy this file to `.env` next to docker-compose.yml and fill in the values.
# `.env` is gitignored by default.

# ---- Domain & TLS ----------------------------------------------------------
# Required for the `caddy` profile (cloud VM). Caddy serves this domain and
# requests a Let's Encrypt cert for it. Must match a DNS A record pointing
# at the host. Unused by the `cloudflared` profile (Cloudflare resolves it
# on the dashboard side).
CELLSEER_DOMAIN=cellseer.com

# Origin(s) allowed by the backend's CORS policy.
# For a single-domain deploy this should be exactly your https origin.
# Comma-separate multiple origins if you serve the SPA from elsewhere.
CELLSEER_ALLOWED_ORIGINS=https://cellseer.com

# ---- Cloudflare Tunnel (only for `cloudflared` profile / Mac host) --------
# Connector token from Cloudflare dashboard → Zero Trust → Networks →
# Tunnels → <your-tunnel> → Install connector → Docker tab → copy the
# string after `--token`. Leave empty for cloud-VM (caddy) deploys.
CF_TUNNEL_TOKEN=

# ---- Auth ------------------------------------------------------------------
# Single shared bearer token. Anyone with this token has full access to all
# /api/* endpoints. Generate something long and random, e.g.:
#   openssl rand -hex 32
# Hand it to users via a one-time URL:
#   https://cellseer.com/?token=<this-value>
# The browser captures the token, stores it in localStorage, and uses it for
# every subsequent request via the Authorization header.
CELLSEER_API_TOKEN=replace-me-with-openssl-rand-hex-32

# ---- DIGIBAT integration (optional) ---------------------------------------
# Leave DATALAB_API_KEY empty to disable upstream sync. The dashboard still
# works against whatever data you've already loaded into SQLite.
DATALAB_BASE_URL=https://digibat.dept.ic.ac.uk
DATALAB_API_KEY=
DATALAB_TIMEOUT=60

# ---- Frontend DIGIBAT base URL (build-time) --------------------------------
# Pre-fills the DIGIBAT connection URL in the UI. Falls back to the IC URL if unset.
VITE_DIGIBAT_BASE_URL=https://digibat.dept.ic.ac.uk
