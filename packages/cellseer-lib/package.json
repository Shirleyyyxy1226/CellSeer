{
  "name": "cellseer-lib",
  "version": "0.1.0",
  "description": "Framework-free Plotly figure builders for battery cycling data (GCD, dQ/dV, dV/dQ, rate performance, voltage–time).",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "plotly.js": ">=2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "battery",
    "cycling",
    "plotly",
    "electrochemistry",
    "dqdv",
    "dvdq",
    "gcd"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shirleyyyxy1226/CellSeer"
  }
}
